{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19.3.0"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".output/",
    ".tanstack/",
    ".source/",
    "**/routeTree.gen.ts",
    "apps/docs/public/r/"
  ],
  "overrides": [
    {
      "files": ["apps/docs/src/components/demos/index.tsx"],
      "rules": {
        "import/default": "off"
      }
    }
  ]
}
